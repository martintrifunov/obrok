{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.js",
    "src/uploads/**",
    "src/data/**"
  ]
}
